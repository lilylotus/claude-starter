<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 用户管理的动态列唯一性校验：column 只接受调用方（UserServiceImpl）从
     tab_metadata_field 目录解析得到、并经白名单校验的合法列名，不接受任意字符串
     拼接，避免 SQL 注入（design.md Decision 8）。-1000 为 UserStatus.DELETED 的字面量，
     与其他状态常量类保持一致，不再单独传参。 -->
<mapper namespace="cn.nihility.rbac.user.mapper.UserMapper">

    <select id="countByColumnValue" resultType="int">
        SELECT COUNT(*)
        FROM tab_user
        WHERE status != -1000
        AND ${column} = #{value}
        <if test="excludeId != null">AND id != #{excludeId}</if>
    </select>

    <!-- 用户分页查询按管辖组织范围过滤：用户与组织没有直接外键，只能通过
         tab_user_position（间接多对多）判断"是否存在至少一条落在管辖范围内的任职记录"。
         用 EXISTS 而不是 JOIN + DISTINCT，避免一个用户多条任职记录导致重复行，
         并配合 MyBatis-Plus 分页插件正确计算 total（user-org-scope-data-permission
         change design.md Decision 2）。allowedOrgIds 为 null 表示不受限制；非 null
         但为空集合时用恒假条件 up.org_id = -1 兜底（design.md Decision 3）。 -->
    <select id="selectUserPage" resultType="cn.nihility.rbac.user.dto.UserVO">
        SELECT u.* FROM tab_user u
        WHERE u.status != #{deletedStatus}
        <if test="name != null and name != ''">AND u.name LIKE CONCAT('%', #{name}, '%')</if>
        <if test="mobile != null and mobile != ''">AND u.mobile LIKE CONCAT('%', #{mobile}, '%')</if>
        <if test="idCard != null and idCard != ''">AND u.id_card LIKE CONCAT('%', #{idCard}, '%')</if>
        <if test="allowedOrgIds != null">
            AND EXISTS (
                SELECT 1 FROM tab_user_position up
                WHERE up.user_id = u.id
                AND up.status != #{positionDeletedStatus}
                <if test="allowedOrgIds.isEmpty()">AND up.org_id = -1</if>
                <if test="!allowedOrgIds.isEmpty()">
                    AND up.org_id IN
                    <foreach collection="allowedOrgIds" item="orgId" open="(" separator="," close=")">#{orgId}</foreach>
                </if>
            )
        </if>
        ORDER BY u.show_order DESC, u.id ASC
    </select>

    <!-- 按管辖组织范围统计用户总数，EXISTS 子查询写法与 selectUserPage 保持一致，供
         首页概览统计接口使用（scope-dashboard-stats-by-admin-org change design.md
         Decision 2）。 -->
    <select id="countUsersInScope" resultType="int">
        SELECT COUNT(*) FROM tab_user u
        WHERE u.status != #{deletedStatus}
        AND EXISTS (
            SELECT 1 FROM tab_user_position up
            WHERE up.user_id = u.id
            AND up.status != #{positionDeletedStatus}
            <if test="allowedOrgIds.isEmpty()">AND up.org_id = -1</if>
            <if test="!allowedOrgIds.isEmpty()">
                AND up.org_id IN
                <foreach collection="allowedOrgIds" item="orgId" open="(" separator="," close=")">#{orgId}</foreach>
            </if>
        )
    </select>

</mapper>
