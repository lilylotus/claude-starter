<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 组织管理的动态列唯一性校验：column 只接受调用方（OrgServiceImpl）从
     tab_metadata_field 目录解析得到、并经白名单校验的合法列名，不接受任意字符串
     拼接，避免 SQL 注入（design.md Decision 8）。-1000 为 OrgStatus.DELETED 的字面量，
     与其他状态常量类保持一致，不再单独传参。 -->
<mapper namespace="cn.nihility.rbac.org.mapper.OrgMapper">

    <select id="countByColumnValue" resultType="int">
        SELECT COUNT(*)
        FROM tab_org
        WHERE status != -1000
        AND ${column} = #{value}
        <if test="excludeId != null">AND id != #{excludeId}</if>
    </select>

    <!-- 分页拉取组织当前数据：不过滤 status（app-sync-drop-changelog change design.md
         Decision 1，停用/已删除记录原样返回），按 update_time ASC, id ASC 排序；
         updateTimeFrom/updateTimeTo/ids/codes 均为可选过滤条件；allowedOrgIds 为 null
         表示不限制，非 null 时按其展开的组织 id 全集过滤，为空集合时用恒假条件兜底
         （design.md Decision 4）。 -->
    <select id="selectSyncPullPage" resultType="cn.nihility.rbac.org.entity.OrgEntity">
        SELECT * FROM tab_org
        <where>
            <if test="updateTimeFrom != null">AND update_time &gt;= #{updateTimeFrom}</if>
            <if test="updateTimeTo != null">AND update_time &lt;= #{updateTimeTo}</if>
            <if test="ids != null">
                <if test="ids.isEmpty()">AND id = -1</if>
                <if test="!ids.isEmpty()">
                    AND id IN
                    <foreach collection="ids" item="itemId" open="(" separator="," close=")">#{itemId}</foreach>
                </if>
            </if>
            <if test="codes != null">
                <if test="codes.isEmpty()">AND 1 = 0</if>
                <if test="!codes.isEmpty()">
                    AND code IN
                    <foreach collection="codes" item="itemCode" open="(" separator="," close=")">#{itemCode}</foreach>
                </if>
            </if>
            <if test="allowedOrgIds != null">
                <if test="allowedOrgIds.isEmpty()">AND id = -1</if>
                <if test="!allowedOrgIds.isEmpty()">
                    AND id IN
                    <foreach collection="allowedOrgIds" item="orgId" open="(" separator="," close=")">#{orgId}</foreach>
                </if>
            </if>
        </where>
        ORDER BY update_time ASC, id ASC
        LIMIT #{offset}, #{limit}
    </select>

</mapper>
