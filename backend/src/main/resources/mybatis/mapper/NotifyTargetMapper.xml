<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 通知候选应用查询：tab_app_config INNER JOIN tab_app INNER JOIN
     tab_app_sync_domain_config，联表条件写在 ON 后，业务过滤条件（sync_domain/
     sync_enabled/应用状态/同步总开关/同步方式）写在 WHERE 后。新增 c.sync_mode = 'NOTIFY'
     条件：拉取模式的应用不再产生任何变更记录，也不需要被匹配为候选应用（app-sync-drop-
     changelog change design.md Decision 6）。c.sync_master_enabled = 1 条件：应用同步
     总开关关闭时不作为候选应用（app-sync-master-switch change design.md Decision 1）。 -->
<mapper namespace="cn.nihility.rbac.sync.notify.mapper.NotifyTargetMapper">

    <select id="selectCandidateAppRefIds" resultType="java.lang.Long">
        SELECT DISTINCT c.app_id
        FROM tab_app_config c
        INNER JOIN tab_app a ON a.id = c.app_id
        INNER JOIN tab_app_sync_domain_config d ON d.app_ref_id = c.app_id
        WHERE d.sync_domain = #{dataType}
        AND d.sync_enabled = 1
        AND a.status = 2000
        AND c.sync_master_enabled = 1
        AND c.sync_mode = 'NOTIFY'
    </select>

</mapper>
