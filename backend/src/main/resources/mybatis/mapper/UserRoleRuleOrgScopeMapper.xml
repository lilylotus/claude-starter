<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 用户角色规则组织范围条件查询：tab_user_role_rule_org_scope 关联 tab_org 回填组织
     名称。用 INNER JOIN（而非 LEFT JOIN）是有意为之：组织若已被删除，对应的组织范围条件
     没有展示价值，直接不返回，风格对齐 PolicyOrgScopeMapper.xml。 -->
<mapper namespace="cn.nihility.rbac.userrole.mapper.UserRoleRuleOrgScopeMapper">

    <select id="selectByRuleId" resultType="cn.nihility.rbac.userrole.dto.UserRoleRuleOrgScopeVO">
        SELECT
        s.org_id AS org_id,
        o.name AS org_name,
        s.include_children AS include_children
        FROM tab_user_role_rule_org_scope s
        INNER JOIN tab_org o ON o.id = s.org_id
        WHERE s.rule_id = #{ruleId}
        ORDER BY o.show_order DESC, o.id ASC
    </select>

</mapper>
