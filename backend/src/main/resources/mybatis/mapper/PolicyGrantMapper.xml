<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 策略计算结果是否命中查询：tab_app_access_policy_grant 关联 tab_app_access_policy
     校验策略当前状态为启用（2000），停用中的策略产生的记录 SHALL NOT 计入（spec.md
     "最终生效权限计算规则"需求）。 -->
<mapper namespace="cn.nihility.rbac.appaccess.policy.mapper.PolicyGrantMapper">

    <select id="existsActiveGrant" resultType="int">
        SELECT COUNT(*)
        FROM tab_app_access_policy_grant g
        INNER JOIN tab_app_access_policy p ON p.id = g.policy_id
        WHERE g.user_id = #{userId}
        AND g.app_id = #{appId}
        AND p.status = 2000
    </select>

    <!-- 按 show_order 升序、id 升序返回候选策略 id（policy-condition-exclusive-priority
         change design.md Decision：运行时最终生效权限判定按该顺序取排在最前的一条候选
         策略计算结果，不再遍历全部候选）。不再使用 DISTINCT：
         tab_app_access_policy_grant 已有 (policy_id, user_id, app_id) 唯一约束，
         固定 user_id/app_id 后 policy_id 天然不重复，直接按 JOIN 后的 show_order/id
         排序即可，避免 DISTINCT 与 ORDER BY 引用非选择列组合在部分 SQL 方言下的歧义。 -->
    <select id="selectActivePolicyIds" resultType="java.lang.Long">
        SELECT g.policy_id
        FROM tab_app_access_policy_grant g
        INNER JOIN tab_app_access_policy p ON p.id = g.policy_id
        WHERE g.user_id = #{userId}
        AND g.app_id = #{appId}
        AND p.status = 2000
        ORDER BY p.show_order ASC, p.id ASC
    </select>

</mapper>
