<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 任职管理的多表查询：tab_user_position 关联 tab_user、tab_org 回填所属用户姓名、
     所属组织名称。若 tab_user/tab_org 的主键列名或表名变更，需要同步修改这里的 JOIN 条件。
     LEFT JOIN（而非 INNER JOIN）是有意为之：关联的用户/组织即便已被删除或查不到，
     任职记录本身仍应正常返回，只是对应的 user_name/org_name 为空。 -->
<mapper namespace="cn.nihility.rbac.user.mapper.UserPositionMapper">

    <sql id="positionJoinColumns">
        up.id AS id,
        up.user_id AS user_id,
        u.name AS user_name,
        up.org_id AS org_id,
        o.name AS org_name,
        up.position_type AS position_type,
        up.position_address AS position_address,
        up.position_phone AS position_phone,
        up.show_order AS show_order,
        up.remark AS remark,
        up.ext1 AS ext1,
        up.ext2 AS ext2,
        up.ext3 AS ext3,
        up.ext4 AS ext4,
        up.ext5 AS ext5,
        up.ext6 AS ext6,
        up.ext7 AS ext7,
        up.ext8 AS ext8,
        up.ext9 AS ext9,
        up.ext10 AS ext10,
        up.status AS status,
        up.create_by AS create_by,
        up.create_time AS create_time,
        up.update_by AS update_by,
        up.update_time AS update_time
    </sql>

    <sql id="positionJoinFrom">
        FROM tab_user_position up
        LEFT JOIN tab_user u ON u.id = up.user_id
        LEFT JOIN tab_org o ON o.id = up.org_id
    </sql>

    <select id="selectPositionPage" resultType="cn.nihility.rbac.user.dto.PositionVO">
        SELECT
        <include refid="positionJoinColumns"/>
        <include refid="positionJoinFrom"/>
        WHERE up.org_id = #{orgId}
        AND up.status != #{deletedStatus}
        ORDER BY up.show_order DESC, up.id ASC
    </select>

    <select id="selectPositionDetail" resultType="cn.nihility.rbac.user.dto.PositionVO">
        SELECT
        <include refid="positionJoinColumns"/>
        <include refid="positionJoinFrom"/>
        WHERE up.id = #{id}
        AND up.status != #{deletedStatus}
    </select>

    <!-- 按管辖组织范围查询全部未被逻辑删除的任职记录，供 master-data-excel-export
         能力的任职导出使用：allowedOrgIds 为 null 表示不限制，非 null（哪怕是空集合）
         表示受限，空集合时用恒不匹配的哨兵条件兜底（design.md Decision 1）。 -->
    <select id="selectAllForExport" resultType="cn.nihility.rbac.user.dto.PositionVO">
        SELECT
        <include refid="positionJoinColumns"/>
        <include refid="positionJoinFrom"/>
        WHERE up.status != #{deletedStatus}
        <if test="allowedOrgIds != null">
            <if test="allowedOrgIds.isEmpty()">AND up.org_id = -1</if>
            <if test="!allowedOrgIds.isEmpty()">
                AND up.org_id IN
                <foreach collection="allowedOrgIds" item="orgId" open="(" separator="," close=")">#{orgId}</foreach>
            </if>
        </if>
        ORDER BY up.id ASC
    </select>

    <!-- 任职管理的动态列唯一性校验：column 只接受调用方（PositionServiceImpl）从
         tab_metadata_field 目录解析得到、并经白名单校验的合法列名，不接受任意字符串
         拼接，避免 SQL 注入（design.md Decision 8）。-1000 为 PositionStatus.DELETED
         的字面量，与其他状态常量类保持一致，不再单独传参。 -->
    <select id="countByColumnValue" resultType="int">
        SELECT COUNT(*)
        FROM tab_user_position
        WHERE status != -1000
        AND ${column} = #{value}
        <if test="excludeId != null">AND id != #{excludeId}</if>
    </select>

    <!-- 分页拉取任职当前数据：不过滤 status（app-sync-drop-changelog change design.md
         Decision 1，停用/已删除记录原样返回），按 update_time ASC, id ASC 排序；单表查询，
         与 BizSnapshotResolver 对 POSITION 域现查返回实体（非 PositionVO）保持一致；
         updateTimeFrom/updateTimeTo/ids 均为可选过滤条件，无 codes 过滤（任职域没有业务
         编码字段）；allowedOrgIds 为 null 表示不限制，非 null 时按 org_id 过滤，为空集合时
         用恒假条件兜底（design.md Decision 4）。 -->
    <select id="selectSyncPullPage" resultType="cn.nihility.rbac.user.entity.UserPositionEntity">
        SELECT * FROM tab_user_position
        <where>
            <if test="updateTimeFrom != null">AND update_time &gt;= #{updateTimeFrom}</if>
            <if test="updateTimeTo != null">AND update_time &lt;= #{updateTimeTo}</if>
            <if test="ids != null">
                <if test="ids.isEmpty()">AND id = -1</if>
                <if test="!ids.isEmpty()">
                    AND id IN
                    <foreach collection="ids" item="itemId" open="(" separator="," close=")">#{itemId}</foreach>
                </if>
            </if>
            <if test="allowedOrgIds != null">
                <if test="allowedOrgIds.isEmpty()">AND org_id = -1</if>
                <if test="!allowedOrgIds.isEmpty()">
                    AND org_id IN
                    <foreach collection="allowedOrgIds" item="orgId" open="(" separator="," close=")">#{orgId}</foreach>
                </if>
            </if>
        </where>
        ORDER BY update_time ASC, id ASC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 对账摘要接口游标式批量查询：按 id 升序、id > lastId 翻页（app-sync-changelog-pull
         change design.md Decision 10），不做 updateTime/ids 过滤。 -->
    <select id="selectDigestBatch" resultType="cn.nihility.rbac.user.entity.UserPositionEntity">
        SELECT * FROM tab_user_position
        <where>
            <if test="lastId != null">AND id &gt; #{lastId}</if>
            <if test="allowedOrgIds != null">
                <if test="allowedOrgIds.isEmpty()">AND org_id = -1</if>
                <if test="!allowedOrgIds.isEmpty()">
                    AND org_id IN
                    <foreach collection="allowedOrgIds" item="orgId" open="(" separator="," close=")">#{orgId}</foreach>
                </if>
            </if>
        </where>
        ORDER BY id ASC
        LIMIT #{batchSize}
    </select>

</mapper>
